# Fiyat Çalışması - sunucu ayarları (şablon).
# kur.ps1 bu dosyayı "ayarlar.env" adıyla kopyalar; DEĞİŞİKLİKLERİ ayarlar.env İÇİNDE yapın.
# Biçim: ANAHTAR=DEGER. "#" ile başlayan satırlar açıklamadır. Boş bırakılan ayar uygulamanın varsayılanını kullanır.
# Bu dosyada şifre/gizli anahtar tutulmaz.

# --- Adres ---
# 0.0.0.0 = ağdaki diğer bilgisayarlar http://<sunucu-adı>:PORT ile erişir. 127.0.0.1 = yalnız bu bilgisayar.
HOST=0.0.0.0
PORT=8000

# --- Veritabanı ---
# Boş = <proje>\veri\fiyat.db. Başka bir yerde tutulacaksa: sqlite:///D:/FiyatVeri/fiyat.db (düz eğik çizgi, yalnız SQLite dosyası).
# Uygulamanın otomatik yedekleri ve yedekle.ps1 yedekleri veritabanı dosyasının yanındaki "yedek" klasörüne yazılır.
VERITABANI_URL=

# --- Giriş ---
# 1 = kullanıcı adı/şifre zorunlu (sunucuda HER ZAMAN 1 kalmalı). 0 = giriş ekranı kapalı (yalnız deneme).
GIRIS_ZORUNLU=1

# --- Performans ---
# 1 = her kayıttan sonra ana sayfa hesapları arka planda yeniden hazırlanır. 0 = kapalı.
ONBELLEK_ISITMA=1

# --- İsteğe bağlı ---
# Derlenmiş arayüz klasörü. Boş = <proje>\frontend\dist.
ARAYUZ_DIZINI=
# Arayüz başka bir adresten sunulacaksa izin verilen kökenler (virgülle). Tek adres kurulumunda boş bırakın.
CORS_ORIGINS=
# Excel'den içe aktarmada varsayılan dosya yolu. Boş = proje kökündeki çalışma dosyası.
EXCEL_YOLU=

# --- Yedek (yedekle.ps1) ---
# Yedeğin ayrıca kopyalanacağı ağ paylaşımı, örn. \\dosyasunucu\yedek\fiyat-calismasi . Boş = yalnız yerel yedek.
YEDEK_AG_KLASORU=
# yedekle.ps1'in kendi aldığı günlük yedeklerden kaç günlük saklanacağı.
YEDEK_TUT_GUN=14

# --- Günlük dosyaları (veri\gunluk) ---
# Sunucu günlüklerinden kaç günlük saklanacağı.
GUNLUK_TUT_GUN=30
